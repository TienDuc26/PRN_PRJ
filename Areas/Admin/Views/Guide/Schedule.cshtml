@model List<TourSchedule>
@{ ViewData["Title"] = "Lịch làm việc"; var g = ViewBag.Guide as Guide; }
<h3>Lịch làm việc: @g?.FullName</h3>
<p><a href="/Admin/Guide" class="btn btn-link"><i class="bi bi-arrow-left"></i> Quay lại</a></p>
@if (!Model.Any())
{
    <p class="text-muted">Chưa có lịch được phân công.</p>
}
else
{
    <table class="table data-table">
        <thead><tr><th>Mã</th><th>Tour</th><th>Khởi hành</th><th>Kết thúc</th><th>Ghi chú</th><th></th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td><code>@s.Code</code></td>
                <td>@s.Tour?.Name</td>
                <td>@s.StartDate.ToString("dd/MM/yyyy")</td>
                <td>@s.EndDate.ToString("dd/MM/yyyy")</td>
                <td>@(s.GuideAssignments.FirstOrDefault(x => x.GuideId == g?.Id)?.Note ?? "")</td>
                <td>
                    <form asp-action="Unassign" asp-route-assignmentId="@s.GuideAssignments.FirstOrDefault(x => x.GuideId == g?.Id)?.Id" asp-route-guideId="@g?.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-x"></i> Hủy phân công</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}