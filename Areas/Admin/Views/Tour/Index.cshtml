@model PagedResult<Tour>
@using TourManagement.Web.Models.Enums
@{
    ViewData["Title"] = "Quản lý tour";
    var filter = Context.Request.Query;
    var destinations = ViewBag.Destinations as List<Destination> ?? new List<Destination>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Danh sách tour</h3>
    <a href="/Admin/Tour/Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Thêm tour</a>
</div>

<form method="get" class="card p-3 mb-3">
    <div class="row g-2">
        <div class="col-md-3"><input type="text" name="keyword" value="@filter["keyword"]" placeholder="Từ khóa" class="form-control form-control-sm" /></div>
        <div class="col-md-3">
            <select name="destinationId" class="form-select form-select-sm">
                <option value="">Tất cả điểm đến</option>
                @foreach (var d in destinations)
                {
                    <option value="@d.Id" selected="@(filter["destinationId"] == d.Id.ToString())">@d.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select form-select-sm">
                <option value="">Tất cả trạng thái</option>
                <option value="1" selected="@(filter["status"]=="1")">Active</option>
                <option value="2" selected="@(filter["status"]=="2")">Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="tourType" class="form-select form-select-sm">
                <option value="">Tất cả loại</option>
                <option value="1" selected="@(filter["tourType"]=="1")">Trong nước</option>
                <option value="2" selected="@(filter["tourType"]=="2")">Quốc tế</option>
            </select>
        </div>
        <div class="col-md-2"><button class="btn btn-primary btn-sm w-100">Lọc</button></div>
    </div>
</form>

<div class="data-table table-responsive">
    <table class="table table-hover mb-0">
        <thead>
            <tr><th>Mã</th><th>Tên</th><th>Điểm đến</th><th>Thời lượng</th><th>Giá</th><th>Loại</th><th>Trạng thái</th><th>Thao tác</th></tr>
        </thead>
        <tbody>
        @foreach (var t in Model.Items)
        {
            <tr>
                <td><code>@t.Code</code></td>
                <td>
                    <strong>@t.Name</strong>
                    @if (!string.IsNullOrEmpty(t.Thumbnail))
                    {
                        <br /><img src="@t.Thumbnail" style="width:60px;height:40px;object-fit:cover" class="mt-1 rounded" />
                    }
                </td>
                <td>@t.Destination?.Name</td>
                <td>@t.DurationDays ngày @t.DurationNights đêm</td>
                <td>@t.BasePrice.ToString("N0") đ</td>
                <td>@((TourType)t.TourType)</td>
                <td>
                    @if (t.Status == 1)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>
                    <a href="/Admin/Tour/Details/@t.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                    <a href="/Admin/Tour/Edit/@t.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                    <a href="/Admin/Tour/Itineraries/@t.Id" class="btn btn-sm btn-outline-success"><i class="bi bi-list-ol"></i></a>
                    <form asp-action="ToggleStatus" asp-route-id="@t.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-warning"><i class="bi bi-toggle-on"></i></button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline" onsubmit="return confirm('Xác nhận xóa?')">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}