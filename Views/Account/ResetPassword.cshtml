@model ResetPasswordViewModel
@{ ViewData["Title"] = "Đặt lại mật khẩu"; var email = ViewBag.Email as string; }
<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm p-4">
                <h2 class="text-center mb-4"><i class="bi bi-shield-lock text-primary"></i> Đặt lại mật khẩu</h2>
                <form asp-action="ResetPassword" method="post">
                    <input type="hidden" name="email" value="@email" />
                    <input type="hidden" asp-for="Token" />
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="mb-3"><label class="form-label">Mật khẩu mới</label>
                        <input asp-for="Password" class="form-control" type="password" /></div>
                    <div class="mb-3"><label class="form-label">Xác nhận</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" /></div>
                    <button type="submit" class="btn btn-primary w-100">Đặt lại</button>
                </form>
            </div>
        </div>
    </div>
</section>