@inject TourManagement.Web.Services.Interfaces.INotificationService _notiService
@inject TourManagement.Web.Services.Interfaces.IDestinationService _destinationService
@inject Microsoft.AspNetCore.Identity.UserManager<TourManagement.Web.Models.Entities.ApplicationUser> _userManager
@using Microsoft.AspNetCore.Http
@{
    var dests = (await _destinationService.GetAllAsync()).Take(8).ToList();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TourViet - Hệ thống đặt tour du lịch trực tuyến hàng đầu Việt Nam" />
    <title>@ViewData["Title"] - TourViet</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var userId = User.GetUserId();
        var unread = userId > 0 ? _notiService.CountUnreadAsync(userId).Result : 0;
        var fullName = User.GetFullName();
    }

    <!-- TOP BAR -->
    <div class="top-bar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="top-info">
                <span class="me-3"><i class="bi bi-telephone-fill"></i> Hotline: <strong>1900 6868</strong></span>
                <span class="me-3"><i class="bi bi-envelope-fill"></i> info@tourviet.com</span>
                <span><i class="bi bi-clock-fill"></i> Hỗ trợ 24/7</span>
            </div>
            <div class="top-actions">
                <a href="#" class="me-3"><i class="bi bi-translate"></i> Tiếng Việt</a>
                <a href="#"><i class="bi bi-currency-exchange"></i> VNĐ</a>
            </div>
        </div>
    </div>

    <!-- MAIN HEADER -->
    <header class="main-header sticky-top">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand logo" href="/">
                    <span class="logo-icon"><i class="bi bi-globe-asia-australia"></i></span>
                    <span class="logo-text">
                        <span class="brand-name">TourViet</span>
                        <span class="brand-tagline">Khám phá Việt Nam</span>
                    </span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto main-menu">
                        <li class="nav-item">
                            <a class="nav-link" href="/"><i class="bi bi-house-door"></i> Trang chủ</a>
                        </li>
                        <li class="nav-item dropdown has-mega">
                            <a class="nav-link dropdown-toggle" href="/Tour" data-bs-toggle="dropdown">
                                <i class="bi bi-geo-alt"></i> Tour du lịch
                            </a>
                            <div class="dropdown-menu mega-menu">
                                <div class="row g-3 p-3" style="min-width:500px">
                                    <div class="col-6">
                                        <h6 class="mega-title">Theo khu vực</h6>
                                        @if (dests.Any())
                                        {
                                            @foreach (var d in dests.Take(6))
                                            {
                                                <a class="mega-item" href="/Tour/ByDestination/@d.Id">
                                                    <i class="bi bi-geo-alt-fill text-primary"></i> @d.Name
                                                    <small class="text-muted d-block ms-4">@d.City, @d.Country</small>
                                                </a>
                                            }
                                        }
                                    </div>
                                    <div class="col-6">
                                        <h6 class="mega-title">Loại tour</h6>
                                        <a class="mega-item" href="/Tour?type=1"><i class="bi bi-tree-fill text-success"></i> Tour sinh thái</a>
                                        <a class="mega-item" href="/Tour?type=2"><i class="bi bi-camera-fill text-info"></i> Tour văn hóa</a>
                                        <a class="mega-item" href="/Tour?type=3"><i class="bi bi-cup-hot-fill text-warning"></i> Tour ẩm thực</a>
                                        <a class="mega-item" href="/Tour?type=4"><i class="bi bi-people-fill text-danger"></i> Tour gia đình</a>
                                        <a class="mega-item" href="/Tour"><i class="bi bi-grid-fill text-secondary"></i> Xem tất cả tour</a>
                                    </div>
                                </div>
                            </div>
                        </li>
                        <li class="nav-item"><a class="nav-link" href="/Home/About"><i class="bi bi-info-circle"></i> Giới thiệu</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Home/Contact"><i class="bi bi-telephone"></i> Liên hệ</a></li>
                    </ul>

                    <ul class="navbar-nav user-menu">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link icon-btn" href="/Notification" title="Thông báo">
                                    <i class="bi bi-bell-fill"></i>
                                    @if (unread > 0)
                                    {
                                        <span class="noti-badge">@unread</span>
                                    }
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link icon-btn" href="/Booking" title="Đơn của tôi">
                                    <i class="bi bi-receipt"></i>
                                </a>
                            </li>
                            <li class="nav-item dropdown user-dropdown">
                                <a class="nav-link dropdown-toggle user-toggle" data-bs-toggle="dropdown">
                                    <span class="user-avatar"><i class="bi bi-person-fill"></i></span>
                                    <span class="user-name d-none d-lg-inline">@fullName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end user-menu-list">
                                    <li class="dropdown-header">
                                        <div class="d-flex align-items-center">
                                            <div class="user-avatar-lg"><i class="bi bi-person-fill"></i></div>
                                            <div>
                                                <div class="fw-bold">@fullName</div>
                                                <small class="text-muted">@(User.Identity?.Name)</small>
                                            </div>
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Profile"><i class="bi bi-person"></i> Hồ sơ của tôi</a></li>
                                    <li><a class="dropdown-item" href="/Booking"><i class="bi bi-receipt"></i> Đơn của tôi</a></li>
                                    <li><a class="dropdown-item" href="/Notification"><i class="bi bi-bell"></i> Thông báo @if (unread > 0){<span class="badge bg-danger ms-2">@unread</span>}</a></li>
                                    <li><a class="dropdown-item" href="/Profile/ChangePassword"><i class="bi bi-shield-lock"></i> Đổi mật khẩu</a></li>
                                    @if (User.IsInRole("ADMIN") || User.IsInRole("STAFF"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-primary" href="/Admin/Dashboard"><i class="bi bi-speedometer2"></i> Trang quản trị</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" action="/Account/Logout" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm me-2" href="/Account/Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm fw-bold" href="/Account/Register">
                                    <i class="bi bi-person-plus"></i> Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- BANNER ALERT -->
    <main role="main">
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3"><div class="alert alert-success-custom alert-dismissible fade show" role="alert"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]<button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button></div></div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container mt-3"><div class="alert alert-danger-custom alert-dismissible fade show" role="alert"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]<button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button></div></div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="container mt-3"><div class="alert alert-warning-custom alert-dismissible fade show" role="alert"><i class="bi bi-exclamation-circle-fill"></i> @TempData["Warning"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div></div>
        }
        @RenderBody()
    </main>

    <!-- TRUST BAR -->
    <section class="trust-bar">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-3 col-6">
                    <div class="trust-item"><i class="bi bi-shield-fill-check"></i><div><strong>Giá tốt nhất</strong><small>Cam kết hoàn tiền nếu cao hơn</small></div></div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="trust-item"><i class="bi bi-headset"></i><div><strong>Hỗ trợ 24/7</strong><small>Hotline: 1900 6868</small></div></div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="trust-item"><i class="bi bi-calendar-x"></i><div><strong>Hủy linh hoạt</strong><small>Hoàn tiền theo chính sách</small></div></div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="trust-item"><i class="bi bi-credit-card-fill"></i><div><strong>Thanh toán an toàn</strong><small>Nhiều phương thức</small></div></div>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="main-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand">
                        <h5 class="footer-logo"><i class="bi bi-globe-asia-australia"></i> TourViet</h5>
                        <p class="footer-desc">Hệ thống quản lý tour du lịch chuyên nghiệp, mang đến cho bạn những chuyến đi tuyệt vời với giá tốt nhất.</p>
                        <div class="footer-social">
                            <a href="#" title="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" title="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="#" title="YouTube"><i class="bi bi-youtube"></i></a>
                            <a href="#" title="TikTok"><i class="bi bi-tiktok"></i></a>
                            <a href="#" title="Zalo"><i class="bi bi-chat-dots"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="footer-title">Liên kết nhanh</h6>
                    <ul class="footer-list">
                        <li><a href="/Tour"><i class="bi bi-chevron-right"></i> Tour nổi bật</a></li>
                        <li><a href="/Tour"><i class="bi bi-chevron-right"></i> Điểm đến</a></li>
                        <li><a href="/Home/About"><i class="bi bi-chevron-right"></i> Về chúng tôi</a></li>
                        <li><a href="/Home/Contact"><i class="bi bi-chevron-right"></i> Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="footer-title">Hỗ trợ khách hàng</h6>
                    <ul class="footer-list">
                        <li><a href="#"><i class="bi bi-chevron-right"></i> Chính sách hủy tour</a></li>
                        <li><a href="#"><i class="bi bi-chevron-right"></i> Điều khoản sử dụng</a></li>
                        <li><a href="#"><i class="bi bi-chevron-right"></i> Chính sách bảo mật</a></li>
                        <li><a href="#"><i class="bi bi-chevron-right"></i> Câu hỏi thường gặp</a></li>
                        <li><a href="#"><i class="bi bi-chevron-right"></i> Hướng dẫn thanh toán</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-title">Liên hệ</h6>
                    <ul class="footer-contact">
                        <li><i class="bi bi-geo-alt-fill"></i> <span>Tầng 8, Tòa nhà Bitexco, Quận 1, TP. Hồ Chí Minh</span></li>
                        <li><i class="bi bi-telephone-fill"></i> <span>Hotline: <strong>1900 6868</strong></span></li>
                        <li><i class="bi bi-envelope-fill"></i> <span>info@tourviet.com</span></li>
                        <li><i class="bi bi-clock-fill"></i> <span>Thứ 2 - CN: 8:00 - 22:00</span></li>
                    </ul>
                    <form class="newsletter mt-3" onsubmit="event.preventDefault(); Swal.fire({icon:'success',title:'Đăng ký thành công!',text:'Cảm ơn bạn đã đăng ký nhận bản tin.'});">
                        <div class="input-group">
                            <input type="email" class="form-control" placeholder="Email nhận bản tin..." required>
                            <button class="btn btn-warning" type="submit"><i class="bi bi-send-fill"></i></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="container d-flex flex-wrap justify-content-between align-items-center">
                <p class="mb-0">© @DateTime.UtcNow.Year TourViet. Bảo lưu mọi quyền.</p>
                <div class="payment-icons">
                    <span class="me-2">Thanh toán:</span>
                    <i class="bi bi-credit-card-2-back"></i>
                    <i class="bi bi-credit-card-2-front"></i>
                    <i class="bi bi-paypal"></i>
                    <i class="bi bi-bank"></i>
                </div>
            </div>
        </div>
    </footer>

    <!-- BACK TO TOP -->
    <button id="backToTop" class="back-to-top" title="Lên đầu trang"><i class="bi bi-arrow-up"></i></button>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>