@{ ViewData["Title"] = "Liên hệ"; }
<section class="container py-5">
    <h1 class="section-title">Liên hệ với chúng tôi</h1>
    <div class="row">
        <div class="col-md-6">
            <div class="card p-4">
                <h5><i class="bi bi-geo-alt text-primary"></i> Địa chỉ</h5>
                <p>123 Nguyễn Huệ, Quận 1, TP. Hồ Chí Minh</p>
                <h5><i class="bi bi-telephone text-primary"></i> Hotline</h5>
                <p>1900 6868</p>
                <h5><i class="bi bi-envelope text-primary"></i> Email</h5>
                <p>info@tourviet.com</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card p-4">
                <h5>Gửi yêu cầu</h5>
                <form>
                    <div class="mb-3"><input class="form-control" placeholder="Họ tên" /></div>
                    <div class="mb-3"><input class="form-control" placeholder="Email" /></div>
                    <div class="mb-3"><textarea class="form-control" rows="4" placeholder="Nội dung"></textarea></div>
                    <button type="button" class="btn btn-primary">Gửi</button>
                </form>
            </div>
        </div>
    </div>
</section>