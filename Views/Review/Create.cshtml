@model ReviewCreateViewModel
@{ ViewData["Title"] = "Đánh giá tour"; }
<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm p-4">
                <h3><i class="bi bi-star text-warning"></i> Đánh giá tour</h3>
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="BookingId" />
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="mb-3">
                        <label class="form-label">Đánh giá của bạn</label>
                        <div id="ratingStars" class="fs-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi bi-star star-btn" data-rating="@i" style="cursor:pointer;color:#ccc"></i>
                            }
                        </div>
                        <input type="hidden" asp-for="Rating" id="ratingInput" value="5" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nội dung</label>
                        <textarea asp-for="Content" class="form-control" rows="4" placeholder="Chia sẻ trải nghiệm của bạn..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hình ảnh (tùy chọn)</label>
                        <input type="file" asp-for="Image" class="form-control" accept="image/*" />
                    </div>
                    <button type="submit" class="btn btn-primary">Gửi đánh giá</button>
                    <a href="/Booking" class="btn btn-link">Quay lại</a>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
document.querySelectorAll('.star-btn').forEach(star => {
    star.addEventListener('click', function() {
        const rating = parseInt(this.dataset.rating);
        document.getElementById('ratingInput').value = rating;
        document.querySelectorAll('.star-btn').forEach(s => {
            const r = parseInt(s.dataset.rating);
            s.classList.toggle('bi-star-fill', r <= rating);
            s.classList.toggle('bi-star', r > rating);
            s.style.color = r <= rating ? '#ffc107' : '#ccc';
        });
    });
    star.addEventListener('mouseenter', function() {
        const rating = parseInt(this.dataset.rating);
        document.querySelectorAll('.star-btn').forEach(s => {
            const r = parseInt(s.dataset.rating);
            s.style.color = r <= rating ? '#ffc107' : '#ccc';
        });
    });
});
document.getElementById('ratingStars').addEventListener('mouseleave', function() {
    const cur = parseInt(document.getElementById('ratingInput').value);
    document.querySelectorAll('.star-btn').forEach(s => {
        const r = parseInt(s.dataset.rating);
        s.style.color = r <= cur ? '#ffc107' : '#ccc';
    });
});
// initial state
document.querySelectorAll('.star-btn').forEach(s => {
    if (parseInt(s.dataset.rating) <= 5) s.classList.replace('bi-star', 'bi-star-fill');
});
</script>
}