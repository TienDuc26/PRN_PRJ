@model BookingCreateViewModel
@using TourManagement.Web.Models.Enums
@{
    ViewData["Title"] = "Đặt tour";
    var schedule = ViewBag.Schedule as TourSchedule;
    var tour = ViewBag.Tour as Tour;
    var isGuest = ViewBag.IsGuest as bool? ?? false;
    var selectedPromo = Model.PromotionCode;
}

<section class="bg-light py-3">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Tour/Details/@tour?.Id">@tour?.Name</a></li>
                <li class="breadcrumb-item active">Đặt tour</li>
            </ol>
        </nav>
    </div>
</section>

<section class="container py-4">
    <h2 class="mb-4"><i class="bi bi-receipt"></i> Đặt tour: @tour?.Name</h2>
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h5 class="card-title">Thông tin lịch khởi hành</h5>
                    <p class="mb-1"><strong>Ngày khởi hành:</strong> @schedule?.StartDate.ToString("dd/MM/yyyy")</p>
                    <p class="mb-1"><strong>Ngày về:</strong> @schedule?.EndDate.ToString("dd/MM/yyyy")</p>
                    <p class="mb-1"><strong>Giờ tập trung:</strong> @schedule?.MeetingTime.ToString(@"hh\:mm")</p>
                    <p class="mb-1"><strong>Điểm tập trung:</strong> @schedule?.MeetingPoint</p>
                    <p class="mb-0"><strong>Số chỗ còn lại:</strong> @schedule?.AvailableSeats / @schedule?.MaxGuests</p>
                </div>
            </div>

            <!-- Guest notice -->
            @if (isGuest)
            {
                <div class="alert alert-info mb-3">
                    <i class="bi bi-info-circle"></i>
                    Bạn đang đặt tour với tư cách <strong>khách vãng lai</strong>.
                    Nếu chưa có tài khoản, bạn có thể <a href="/Account/Register?returnUrl=/Booking/Create?scheduleId=@Model.ScheduleId">đăng ký nhanh</a>
                    hoặc <a href="/Account/Login?returnUrl=/Booking/Create?scheduleId=@Model.ScheduleId">đăng nhập</a>.
                    Thông tin bạn nhập sẽ được giữ nguyên sau khi đăng nhập/đăng ký.
                </div>
            }

            <form asp-action="Create" method="post" id="bookingForm">
                <input type="hidden" asp-for="ScheduleId" />
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <h5>1. Số lượng khách</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Người lớn</label>
                                <input asp-for="Adults" type="number" min="1" class="form-control" id="adultsInput" value="@Model.Adults" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Trẻ em</label>
                                <input asp-for="Children" type="number" min="0" class="form-control" id="childrenInput" value="@Model.Children" />
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="genParticipants">
                            <i class="bi bi-person-plus"></i> Tạo form nhập thông tin
                        </button>
                    </div>
                </div>

                <div class="card shadow-sm mb-3" id="participantsCard" style="display:none">
                    <div class="card-body">
                        <h5>2. Thông tin người tham gia</h5>
                        <div id="participantsList"></div>
                    </div>
                </div>

                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <h5>3. Khuyến mãi (không bắt buộc)</h5>
                        <div class="input-group">
                            <input type="text" id="promoCode" class="form-control" placeholder="Nhập mã khuyến mãi" value="@selectedPromo" />
                            <button type="button" class="btn btn-primary" id="applyPromo">
                                <i class="bi bi-tag"></i> Áp dụng
                            </button>
                        </div>
                        <small id="promoMsg" class="text-muted"></small>
                        <input type="hidden" asp-for="PromotionCode" id="promoCodeHidden" value="@selectedPromo" />
                    </div>
                </div>

                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <h5>4. Ghi chú</h5>
                        <textarea asp-for="Note" class="form-control" rows="2" placeholder="Yêu cầu đặc biệt..."></textarea>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100" id="btnSubmit">
                    <i class="bi bi-check-circle"></i> Xác nhận đặt tour
                </button>
            </form>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm sticky-top" style="top:80px">
                <div class="card-body">
                    <h5>Tóm tắt đơn hàng</h5>
                    <p class="mb-1"><strong>Tour:</strong> @tour?.Name</p>
                    <p class="mb-1"><strong>Khởi hành:</strong> @schedule?.StartDate.ToString("dd/MM/yyyy")</p>
                    <hr />
                    <div class="d-flex justify-content-between"><span>Đơn giá:</span><strong>@schedule?.Price.ToString("N0") đ</strong></div>
                    <div class="d-flex justify-content-between"><span>Trẻ em giảm:</span><strong>30%</strong></div>
                    <small class="text-muted">*Trẻ em được giảm 30% giá vé</small>
                    <hr />
                    <p class="text-muted">Tổng tiền sẽ được tính khi xác nhận.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Guest Login Modal -->
<div class="modal fade" id="guestLoginModal" tabindex="-1" aria-labelledby="guestLoginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="guestLoginModalLabel"><i class="bi bi-box-arrow-in-right"></i> Vui lòng đăng nhập</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <i class="bi bi-bag-check text-primary" style="font-size:3rem"></i>
                </div>
                <p class="lead">Bạn đang đặt tour <strong>@tour?.Name</strong></p>
                <p class="text-muted">Vui lòng đăng nhập hoặc tạo tài khoản để hoàn tất đặt tour.</p>
                <p class="small text-success"><i class="bi bi-check-circle"></i> Thông tin bạn nhập sẽ được giữ nguyên.</p>
            </div>
            <div class="modal-footer flex-column">
                <a href="/Account/Login?returnUrl=/Booking/ContinueFromGuest" class="btn btn-primary w-100 mb-2">
                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                </a>
                <a href="/Account/Register?returnUrl=/Booking/ContinueFromGuest" class="btn btn-warning w-100">
                    <i class="bi bi-person-plus"></i> Tạo tài khoản mới
                </a>
                <button type="button" class="btn btn-link text-muted mt-2" data-bs-dismiss="modal">Quay lại chọn tour</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function() {
    var selectedPromo = @Html.Raw(selectedPromo != null ? $"'{selectedPromo.Replace("'", "\\'")}'" : "null");

    // Khi Guest submit form → lưu session trước, rồi cho redirect
    var form = document.getElementById('bookingForm');
    if (form) {
        form.addEventListener('submit', async function(e) {
            var isGuest = @Html.Raw(isGuest ? "true" : "false");
            if (!isGuest) return; // Customer → submit bình thường

            e.preventDefault(); // Chặn submit tạm

            // Lưu lựa chọn vào Session
            var adults = parseInt(document.getElementById('adultsInput').value) || 1;
            var children = parseInt(document.getElementById('childrenInput').value) || 0;
            var promoCode = document.getElementById('promoCode').value.trim();
            var scheduleId = @Model.ScheduleId;
            var tourId = @tour?.Id ?? 0;

            await fetch('/Booking/SaveGuestSelection', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    tourId: tourId,
                    scheduleId: scheduleId,
                    adults: adults,
                    children: children,
                    promoCode: promoCode || null
                })
            });

            // Hiện modal hướng dẫn đăng nhập
            var modal = new bootstrap.Modal(document.getElementById('guestLoginModal'));
            modal.show();
        });
    }

    // Nếu có promo đã chọn từ URL → tự động apply
    if (selectedPromo) {
        document.getElementById('promoCode').value = selectedPromo;
        setTimeout(function() {
            document.getElementById('applyPromo').click();
        }, 300);
    }
})();

document.getElementById('genParticipants').addEventListener('click', function() {
    var adults = parseInt(document.getElementById('adultsInput').value) || 0;
    var children = parseInt(document.getElementById('childrenInput').value) || 0;
    var total = adults + children;
    if (total <= 0) { alert('Vui lòng nhập số khách'); return; }
    var list = document.getElementById('participantsList');
    list.innerHTML = '';
    for (var i = 0; i < total; i++) {
        var isAdult = i < adults;
        list.insertAdjacentHTML('beforeend', '<div class="border rounded p-3 mb-3"><h6 class="mb-3">Người thứ ' + (i+1) + ' ' + (isAdult ? '(Người lớn)' : '(Trẻ em)') + '</h6><div class="row"><div class="col-md-6 mb-2"><label class="form-label small">Họ tên *</label><input class="form-control" name="Participants[' + i + '].FullName" required /></div><div class="col-md-6 mb-2"><label class="form-label small">Ngày sinh</label><input type="date" class="form-control" name="Participants[' + i + '].DateOfBirth" /></div><div class="col-md-4 mb-2"><label class="form-label small">Giới tính</label><select class="form-select" name="Participants[' + i + '].Gender"><option value="1">Nam</option><option value="2">Nữ</option></select></div><div class="col-md-4 mb-2"><label class="form-label small">CMND/CCCD</label><input class="form-control" name="Participants[' + i + '].IdentityNumber" /></div><div class="col-md-4 mb-2"><label class="form-label small">Điện thoại</label><input class="form-control" name="Participants[' + i + '].Phone" /></div><input type="hidden" name="Participants[' + i + '].IsAdult" value="' + (isAdult ? 'true' : 'false') + '" /></div></div>');
    }
    document.getElementById('participantsCard').style.display = 'block';
    document.getElementById('participantsCard').scrollIntoView({ behavior: 'smooth' });
});

document.getElementById('applyPromo').addEventListener('click', async function() {
    var code = document.getElementById('promoCode').value.trim();
    var msg = document.getElementById('promoMsg');
    if (!code) { msg.innerHTML = '<span class="text-danger">Vui lòng nhập mã</span>'; return; }
    var adults = parseInt(document.getElementById('adultsInput').value) || 1;
    var children = parseInt(document.getElementById('childrenInput').value) || 0;
    var price = parseFloat('@schedule?.Price' || 0);
    var amount = price * adults + price * 0.7 * children;
    var r = await fetch('/Booking/CheckPromo?code=' + encodeURIComponent(code) + '&amount=' + amount);
    var d = await r.json();
    if (d.success) {
        msg.innerHTML = '<span class="text-success">&#10003; ' + d.message + ' - Giảm: ' + Math.round(d.discount).toLocaleString('vi-VN') + ' đ</span>';
        document.getElementById('promoCodeHidden').value = code;
    } else {
        msg.innerHTML = '<span class="text-danger">&#10007; ' + d.message + '</span>';
        document.getElementById('promoCodeHidden').value = '';
    }
});
</script>
}