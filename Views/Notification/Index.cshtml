@model List<Notification>
@{ ViewData["Title"] = "Thông báo"; var unread = (int)(ViewBag.Unread ?? 0); }
<section class="bg-light py-4">
    <div class="container d-flex justify-content-between align-items-center">
        <h2><i class="bi bi-bell"></i> Thông báo</h2>
        @if (unread > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-primary">Đánh dấu tất cả đã đọc</button>
            </form>
        }
    </div>
</section>

<section class="container py-4">
    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-bell-slash"></i><p>Không có thông báo nào</p></div>
    }
    else
    {
        @foreach (var n in Model)
        {
            <div class="card mb-2 shadow-sm @(n.Status == 1 ? "border-primary" : "")">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="mb-1">
                                @if (n.Status == 1) { <span class="badge bg-primary">Mới</span> }
                                @n.Title
                            </h6>
                            <p class="mb-1">@n.Content</p>
                            <small class="text-muted">@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div>
                            @if (!string.IsNullOrEmpty(n.Link))
                            {
                                <a href="@n.Link" class="btn btn-sm btn-outline-primary">Xem</a>
                            }
                            @if (n.Status == 1)
                            {
                                <form asp-action="MarkRead" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@n.Id" />
                                    <button class="btn btn-sm btn-link">Đã đọc</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</section>