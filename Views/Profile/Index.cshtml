@model ProfileUpdateViewModel
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}
@inject UserManager<TourManagement.Web.Models.Entities.ApplicationUser> UserManager
<section class="bg-light py-4">
    <div class="container">
        <h2><i class="bi bi-person-circle"></i> Hồ sơ cá nhân</h2>
    </div>
</section>
<section class="container py-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm text-center p-4">
                <img src="@(Model.AvatarPath ?? "https://ui-avatars.com/api/?name=" + Model.FullName + "&size=150&background=random")" class="rounded-circle mx-auto mb-3" style="width:150px;height:150px;object-fit:cover">
                <h5>@Model.FullName</h5>
                <p class="text-muted">@(User.Identity?.Name)</p>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Index" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="mb-3">
                            <label class="form-label">Họ và tên</label>
                            <input asp-for="FullName" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Số điện thoại</label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Địa chỉ</label>
                            <input asp-for="Address" class="form-control" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Ngày sinh</label>
                                <input asp-for="DateOfBirth" type="date" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Giới tính</label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">--</option>
                                    <option value="1">Nam</option>
                                    <option value="2">Nữ</option>
                                    <option value="3">Khác</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ảnh đại diện</label>
                            <input type="file" name="avatar" class="form-control" accept="image/*" />
                        </div>
                        <button type="submit" class="btn btn-primary">Cập nhật</button>
                        <a href="/Profile/ChangePassword" class="btn btn-outline-secondary">Đổi mật khẩu</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>