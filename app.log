      LEFT JOIN [BookingParticipants] AS [b0] ON [t1].[Id] = [b0].[BookingId]
      LEFT JOIN [Payments] AS [p0] ON [t1].[Id] = [p0].[BookingId]
      ORDER BY [t1].[Id], [t1].[Id0], [t1].[Id1], [t1].[Id2], [t1].[Id3], [t1].[Id4], [t1].[Id5], [b0].[Id]
