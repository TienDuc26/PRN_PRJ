          SELECT TOP(1) [b].[Id], [b].[Adults], [b].[BookedAt], [b].[BookingCode], [b].[CancelledAt], [b].[Children], [b].[CompletedAt], [b].[ConfirmedAt], [b].[CreatedAt], [b].[Discount], [b].[Note], [b].[PaidAmount], [b].[PaymentStatus], [b].[PromotionId], [b].[ScheduleId], [b].[Status], [b].[Subtotal], [b].[Surcharge], [b].[TotalAmount], [b].[UpdatedAt], [b].[UserId], [u].[Id] AS [Id0], [u].[AccessFailedCount], [u].[Address], [u].[Avatar], [u].[ConcurrencyStamp], [u].[CreatedAt] AS [CreatedAt0], [u].[DateOfBirth], [u].[Email], [u].[EmailConfirmed], [u].[FullName], [u].[Gender], [u].[LockoutEnabled], [u].[LockoutEnd], [u].[NormalizedEmail], [u].[NormalizedUserName], [u].[PasswordHash], [u].[PhoneNumber], [u].[PhoneNumberConfirmed], [u].[SecurityStamp], [u].[Status] AS [Status0], [u].[TwoFactorEnabled], [u].[UpdatedAt] AS [UpdatedAt0], [u].[UserName], [t].[Id] AS [Id1], [t].[BookedGuests], [t].[Code], [t].[CreatedAt] AS [CreatedAt1], [t].[EndDate], [t].[MaxGuests], [t].[MeetingPoint], [t].[MeetingTime], [t].[Price], [t].[RowVersion], [t].[StartDate], [t].[Status] AS [Status1], [t].[TourId], [t].[UpdatedAt] AS [UpdatedAt1], [t0].[Id] AS [Id2], [t0].[BasePrice], [t0].[Code] AS [Code0], [t0].[CreatedAt] AS [CreatedAt2], [t0].[Description], [t0].[DestinationId], [t0].[DurationDays], [t0].[DurationNights], [t0].[ExcludedServices], [t0].[IncludedServices], [t0].[Name], [t0].[Policy], [t0].[RowVersion] AS [RowVersion0], [t0].[Status] AS [Status2], [t0].[Thumbnail], [t0].[TourType], [t0].[UpdatedAt] AS [UpdatedAt2], [d].[Id] AS [Id3], [d].[City], [d].[Country], [d].[CreatedAt] AS [CreatedAt3], [d].[Description] AS [Description0], [d].[Image], [d].[Name] AS [Name0], [d].[Status] AS [Status3], [d].[UpdatedAt] AS [UpdatedAt3], [p].[Id] AS [Id4], [p].[Code] AS [Code1], [p].[CreatedAt] AS [CreatedAt4], [p].[Description] AS [Description1], [p].[DiscountType], [p].[DiscountValue], [p].[EndAt], [p].[MaxDiscount], [p].[MinOrderValue], [p].[Name] AS [Name1], [p].[StartAt], [p].[Status] AS [Status4], [p].[UpdatedAt] AS [UpdatedAt4], [p].[UsageCount], [p].[UsageLimit], [r].[Id] AS [Id5], [r].[BookingId], [r].[Content], [r].[CreatedAt] AS [CreatedAt5], [r].[Image] AS [Image0], [r].[Rating], [r].[Status] AS [Status5], [r].[TourId] AS [TourId0], [r].[UserId] AS [UserId0]
          FROM [Bookings] AS [b]
          INNER JOIN [Users] AS [u] ON [b].[UserId] = [u].[Id]
          INNER JOIN [TourSchedules] AS [t] ON [b].[ScheduleId] = [t].[Id]
          INNER JOIN [Tours] AS [t0] ON [t].[TourId] = [t0].[Id]
          INNER JOIN [Destinations] AS [d] ON [t0].[DestinationId] = [d].[Id]
          LEFT JOIN [Promotions] AS [p] ON [b].[PromotionId] = [p].[Id]
          LEFT JOIN [Reviews] AS [r] ON [b].[Id] = [r].[BookingId]
          WHERE [b].[Id] = @__id_0
